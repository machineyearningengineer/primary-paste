{
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    ".cloudflare/types/**/*.d.ts",
    "test/**/*.ts"
  ]
}
